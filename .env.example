# Speak Helper — optional environment fallback
#
# Recommended: configure Base URL, API Key, and models in ⚙ Settings (saved to config.json).
# No .env required. Model variables below are OPTIONAL — not required even when using .env.
#
# Priority per field: Settings / config.json → .env → built-in defaults
#
# Copy to one of (first found wins):
#   - speak_helper/.env
#   - %APPDATA%\speak_helper\.env   (Windows user config dir)
#   - repo root .env                (monorepo development)

# ── OpenAI-compatible TTS (when backend=openai in Settings) ─────────────────
# BASE_URL=https://api.siliconflow.cn/v1
# API_KEY=sk-your-key-here
# TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B      # optional — can set model in Settings
# TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:anna   # optional

# ── OCR vision model (optional — Settings → OCR) ─────────────────────────────
# OCR_MODEL=PaddlePaddle/PaddleOCR-VL-1.5

# ── Edge TTS voice (optional — default backend, no API key) ──────────────────
# EDGE_VOICE=zh-CN-XiaoxiaoNeural

# ── Backend override (optional) ────────────────────────────────────────────
# TTS_BACKEND=edge
# TTS_BACKEND=openai
